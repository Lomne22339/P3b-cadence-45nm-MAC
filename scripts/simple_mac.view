# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
# Single-corner, single-mode MMMC setup for Innovus -- matches simple_mac.sdc

create_library_set -name timing_lib \
    -timing {/cadence/FOUNDRY/digital/45nm/dig/lib/slow.lib}

create_constraint_mode -name sdc1 \
    -sdc_files {../syn_report/simple_mac_pd.sdc}

create_delay_corner -name delay1 \
    -early_library_set {timing_lib} \
    -late_library_set  {timing_lib}

create_analysis_view -name view1 \
    -constraint_mode {sdc1} -delay_corner {delay1}

set_analysis_view -setup {view1} -hold {view1}
